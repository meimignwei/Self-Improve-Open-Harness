{
  "dashboard": {
    "title": "OpenHarness",
    "description": "OpenHarness CLI AI Coding Assistant observability dashboard",
    "tags": ["openharness", "ai", "cli"],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "10s",
    "panels": [
      {
        "id": 1,
        "type": "row",
        "title": "Overview",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
        "collapsed": false
      },
      {
        "id": 2,
        "title": "Agent Turns / min",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
        "targets": [
          {
            "expr": "rate(oh_agent_turns_total[$__rate_interval])",
            "legendFormat": "{{model}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "cpm",
            "custom": { "drawStyle": "line", "fillOpacity": 10 }
          }
        }
      },
      {
        "id": 3,
        "title": "API Calls / min",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
        "targets": [
          {
            "expr": "rate(oh_api_calls_total[$__rate_interval])",
            "legendFormat": "{{model}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "cpm",
            "custom": { "drawStyle": "line", "fillOpacity": 10 }
          }
        }
      },
      {
        "id": 4,
        "title": "Active Sessions",
        "type": "stat",
        "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
        "targets": [
          {
            "expr": "oh_session_active",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }] } }
        }
      },
      {
        "id": 10,
        "type": "row",
        "title": "Latency",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
        "collapsed": false
      },
      {
        "id": 11,
        "title": "Agent Turn Duration (p50/p95/p99)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(oh_agent_turn_duration_seconds_bucket[$__rate_interval]))",
            "legendFormat": "p50",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, rate(oh_agent_turn_duration_seconds_bucket[$__rate_interval]))",
            "legendFormat": "p95",
            "refId": "B"
          },
          {
            "expr": "histogram_quantile(0.99, rate(oh_agent_turn_duration_seconds_bucket[$__rate_interval]))",
            "legendFormat": "p99",
            "refId": "C"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "custom": { "drawStyle": "line", "fillOpacity": 10 }
          }
        }
      },
      {
        "id": 12,
        "title": "API Latency (p50/p95)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(oh_api_latency_seconds_bucket[$__rate_interval]))",
            "legendFormat": "p50",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, rate(oh_api_latency_seconds_bucket[$__rate_interval]))",
            "legendFormat": "p95",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "custom": { "drawStyle": "line", "fillOpacity": 10 }
          }
        }
      },
      {
        "id": 13,
        "title": "Tool Latency (avg)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
        "targets": [
          {
            "expr": "rate(oh_tool_latency_seconds_sum[$__rate_interval]) / rate(oh_tool_latency_seconds_count[$__rate_interval])",
            "legendFormat": "{{tool}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "custom": { "drawStyle": "line", "fillOpacity": 10 }
          }
        }
      },
      {
        "id": 20,
        "type": "row",
        "title": "Tokens & Cost",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 },
        "collapsed": false
      },
      {
        "id": 21,
        "title": "Token Usage / min",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 27 },
        "targets": [
          {
            "expr": "rate(oh_api_tokens_input_total[$__rate_interval])",
            "legendFormat": "input {{model}}",
            "refId": "A"
          },
          {
            "expr": "rate(oh_api_tokens_output_total[$__rate_interval])",
            "legendFormat": "output {{model}}",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "t/min",
            "custom": { "drawStyle": "line", "fillOpacity": 10 }
          }
        }
      },
      {
        "id": 22,
        "title": "Cost / min (USD)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 27 },
        "targets": [
          {
            "expr": "rate(oh_api_cost_total[$__rate_interval])",
            "legendFormat": "{{model}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "USD/min",
            "custom": { "drawStyle": "line", "fillOpacity": 10 },
            "decimals": 6
          }
        }
      },
      {
        "id": 23,
        "title": "Cumulative Cost (USD)",
        "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 0, "y": 35 },
        "targets": [
          {
            "expr": "oh_api_cost_total",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "USD",
            "decimals": 4,
            "color": { "mode": "thresholds" },
            "thresholds": { "steps": [{ "color": "green", "value": null }] }
          }
        }
      },
      {
        "id": 24,
        "title": "Cumulative Input Tokens",
        "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 6, "y": 35 },
        "targets": [
          {
            "expr": "oh_api_tokens_input_total",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": { "mode": "thresholds" },
            "thresholds": { "steps": [{ "color": "blue", "value": null }] }
          }
        }
      },
      {
        "id": 25,
        "title": "Cumulative Output Tokens",
        "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 12, "y": 35 },
        "targets": [
          {
            "expr": "oh_api_tokens_output_total",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": { "mode": "thresholds" },
            "thresholds": { "steps": [{ "color": "blue", "value": null }] }
          }
        }
      },
      {
        "id": 30,
        "type": "row",
        "title": "Errors & Tools",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 39 },
        "collapsed": false
      },
      {
        "id": 31,
        "title": "API Errors / min",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 6, "x": 0, "y": 40 },
        "targets": [
          {
            "expr": "rate(oh_api_errors_total[$__rate_interval])",
            "legendFormat": "{{model}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "cpm",
            "custom": { "drawStyle": "line", "fillOpacity": 10 },
            "color": { "mode": "palette-classic" },
            "thresholds": { "steps": [{ "color": "red", "value": null }] }
          }
        }
      },
      {
        "id": 32,
        "title": "API Retries / min",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 6, "x": 6, "y": 40 },
        "targets": [
          {
            "expr": "rate(oh_api_retries_total[$__rate_interval])",
            "legendFormat": "{{model}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "cpm",
            "custom": { "drawStyle": "line", "fillOpacity": 10 }
          }
        }
      },
      {
        "id": 33,
        "title": "Tool Calls / min",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 6, "x": 12, "y": 40 },
        "targets": [
          {
            "expr": "rate(oh_tool_calls_total[$__rate_interval])",
            "legendFormat": "{{tool}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "cpm",
            "custom": { "drawStyle": "line", "fillOpacity": 10 }
          }
        }
      },
      {
        "id": 34,
        "title": "Tool Errors / min",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 6, "x": 18, "y": 40 },
        "targets": [
          {
            "expr": "rate(oh_tool_errors_total[$__rate_interval])",
            "legendFormat": "{{tool}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "cpm",
            "custom": { "drawStyle": "line", "fillOpacity": 10 },
            "color": { "mode": "palette-classic" },
            "thresholds": { "steps": [{ "color": "red", "value": null }] }
          }
        }
      },
      {
        "id": 35,
        "title": "Tool Output Size (avg bytes)",
        "type": "timeseries",
        "gridPos": { "h": 6, "w": 12, "x": 0, "y": 48 },
        "targets": [
          {
            "expr": "rate(oh_tool_output_size_bytes_sum[$__rate_interval]) / rate(oh_tool_output_size_bytes_count[$__rate_interval])",
            "legendFormat": "{{tool}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "bytes",
            "custom": { "drawStyle": "line", "fillOpacity": 10 }
          }
        }
      },
      {
        "id": 40,
        "type": "row",
        "title": "JVM",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 54 },
        "collapsed": false
      },
      {
        "id": 41,
        "title": "JVM Heap Memory",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 55 },
        "targets": [
          {
            "expr": "oh_jvm_memory_heap_bytes",
            "legendFormat": "{{area}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "bytes",
            "custom": { "drawStyle": "line", "fillOpacity": 10 }
          }
        }
      },
      {
        "id": 42,
        "title": "JVM Thread Count",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 55 },
        "targets": [
          {
            "expr": "oh_jvm_threads",
            "legendFormat": "threads",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "custom": { "drawStyle": "line", "fillOpacity": 10 }
          }
        }
      },
      {
        "id": 50,
        "type": "row",
        "title": "Application Logs",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 63 },
        "collapsed": false
      },
      {
        "id": 51,
        "title": "Application Logs",
        "type": "logs",
        "gridPos": { "h": 12, "w": 24, "x": 0, "y": 64 },
        "targets": [
          {
            "expr": "{job=\"openharness\"}",
            "refId": "A"
          }
        ],
        "options": {
          "showTime": true,
          "showLabels": true,
          "wrapLogMessage": true
        }
      },
      {
        "id": 52,
        "title": "Error Logs (last 5 min)",
        "type": "logs",
        "gridPos": { "h": 8, "w": 24, "x": 0, "y": 76 },
        "targets": [
          {
            "expr": "{job=\"openharness\"} |= \"ERROR\"",
            "refId": "A"
          }
        ],
        "options": {
          "showTime": true,
          "showLabels": true,
          "wrapLogMessage": true
        }
      }
    ],
    "templating": {
      "list": [
        {
          "name": "model",
          "type": "query",
          "label": "Model",
          "query": "label_values(oh_agent_turns_total, model)",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "multi": true,
          "includeAll": true
        }
      ]
    },
    "time": {
      "from": "now-1h",
      "to": "now"
    }
  }
}
