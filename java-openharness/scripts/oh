#!/usr/bin/env bash
# OpenHarness CLI wrapper (Linux / macOS)
# Finds the JAR relative to this script, or in the default install location.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
JAR_DIR="${OH_JAR_DIR:-}"

if [ -z "$JAR_DIR" ]; then
    # 1. Check relative to this script (development layout)
    if [ -f "$SCRIPT_DIR/../openharness-app/target/openharness-app-0.1.0-SNAPSHOT.jar" ]; then
        JAR_DIR="$SCRIPT_DIR/../openharness-app/target"
    elif [ -f "$SCRIPT_DIR/../target/openharness-app-0.1.0-SNAPSHOT.jar" ]; then
        JAR_DIR="$SCRIPT_DIR/../target"
    # 2. Default install location
    elif [ -f "$HOME/.openharness/lib/openharness.jar" ]; then
        JAR_DIR="$HOME/.openharness/lib"
        JAR_NAME="openharness.jar"
    fi
fi

JAR_NAME="${JAR_NAME:-openharness-app-0.1.0-SNAPSHOT.jar}"
JAR="$JAR_DIR/$JAR_NAME"

if [ ! -f "$JAR" ]; then
    echo "Error: OpenHarness JAR not found at $JAR" >&2
    echo "Set OH_JAR_DIR to the directory containing the JAR, or install to ~/.openharness/lib/" >&2
    exit 1
fi

JAVA_BIN="${JAVA_HOME:-$(which java)}"
if [ -z "$JAVA_BIN" ]; then
    echo "Error: Java 21+ required. Install from https://adoptium.net/" >&2
    exit 1
fi

exec "$JAVA_BIN" -jar "$JAR" "$@"
