<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.openharness.core.persistence.mapper.SessionMapper">

    <resultMap id="sessionResult" type="io.openharness.core.persistence.model.Session">
        <id property="id" column="id"/>
        <result property="status" column="status"/>
        <result property="model" column="model"/>
        <result property="maxTurns" column="max_turns"/>
        <result property="cost" column="cost"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="findById" resultMap="sessionResult">
        SELECT * FROM sessions WHERE id = #{id}
    </select>

    <select id="findAll" resultMap="sessionResult">
        SELECT * FROM sessions ORDER BY updated_at DESC
    </select>

    <insert id="insert">
        INSERT INTO sessions (id, status, model, max_turns, cost, created_at, updated_at)
        VALUES (#{id}, #{status}, #{model}, #{maxTurns}, #{cost}, #{createdAt}, #{updatedAt})
    </insert>

    <update id="update">
        UPDATE sessions SET status = #{status}, cost = #{cost}, updated_at = #{updatedAt}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM sessions WHERE id = #{id}
    </delete>
</mapper>
