**切换步骤**：

```bash
# 1. 部署 Logtail 采集器（ECS 上通常已预装）
# 2. 在 SLS 控制台创建 Logstore + 索引配置
# 3. 配置 Logtail 采集路径

# Logtail 采集配置 (ilogtail_config.json)
{
  "inputs": [
    {
      "type": "service_logtail",
      "detail": {
        "LogPath": "/home/<user>/.oh/logs/",
        "FilePattern": "oh.json",         // 采集 JSON 日志
        "LogType": "json_log",            // 自动解析 JSON 字段
        "TopicFormat": "none",
        "EnableTag": true
      }
    },
    {
      "type": "service_logtail",
      "detail": {
        "LogPath": "/home/<user>/.oh/logs/",
        "FilePattern": "metrics.log",     // 采集 Metrics
        "LogType": "common_reg_log"
      }
    }
  ]
