### 7.5 Session 回放

```java
/**
 * 会话录制与回放。通过 AsyncPersistenceWriter 异步写入 MySQL replay_events 表。
 * record* 方法只做 queue.offer()，不阻塞 Agent 主循环。
 */
public class SessionRecorder {

    private final AsyncPersistenceWriter writer;

    /** 录制 API 请求（脱敏后，API key 自动替换为 ***） */
    public void recordApiRequest(String sessionId, int turn, ApiRequest request) {
        writer.enqueue(new ReplayEvent(sessionId, turn, "api_request",
            request.toJson(), null, null, null));
    }

    /** 录制 API 响应 */
    public void recordApiResponse(String sessionId, int turn, ApiResponse response) {
        writer.enqueue(new ReplayEvent(sessionId, turn, "api_response",
            null, response.toJson(), null, null));
    }

    /** 录制工具调用 */
    public void recordToolCall(String sessionId, int turn,
                                String toolName, Map<String, Object> args,
                                ToolResult result) {
        writer.enqueue(new ReplayEvent(sessionId, turn, "tool_call",
            null, null, toJson(args), toJson(result)));
    }

    /** 回放查询: 按 sessionId 查出全部事件，按 turn 重排 */
    public List<ReplayEvent> loadReplay(String sessionId) {
        return replayMapper.findBySessionId(sessionId);
    }
}
```

